    "@supabase/supabase-js": "^2.112.3",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-auth-session": "~58.0.19",
    "expo-blur": "~58.0.6",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "auth:urls": "node --env-file-if-exists=.env scripts/auth-urls.mjs",
    "test": "node --import ./scripts/register-test-loader.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "release:check": "node --env-file-if-exists=.env scripts/release-check.mjs",
    "health:check": "node --env-file-if-exists=.env scripts/health-check.mjs",
    "export:ios": "expo export --platform ios",
    "export:web": "expo export --platform web",
    "preview:design": "node scripts/design-preview.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
