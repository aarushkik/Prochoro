# Copy to .env and fill in from Supabase → Project Settings → API.
#
# EXPO_PUBLIC_ prefixed vars are inlined into the JS bundle at build time,
# which is correct for these two: the client key is designed to be public and
# is safe to ship *provided row level security is on* (see supabase/schema.sql).
#
# Use the **publishable** key (`sb_publishable_...`) if your project offers one.
# The older `anon` key still works and goes in the same place — the variable
# keeps its original name so existing .env files do not break.
#
# Never put the **secret** key (`sb_secret_...`, formerly `service_role`) in
# here. It bypasses RLS entirely and would give anyone who unpacked the app
# full read/write on every student's data.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Sign in with Apple (iOS only, via the system sheet). Turn on once Supabase →
# Authentication → Providers → Apple is enabled with this app's bundle ID,
# com.aarushkik.studyplat, listed under Client IDs. No Services ID, key or
# client secret is needed for native sign-in itself. Account deletion does need
# a server-only Apple signing key and the deployed revocation function.
# Complete docs/apple-sign-in.md before enabling this for a release.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
